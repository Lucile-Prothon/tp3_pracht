---
import PlotFigure from "../components/PlotFigure.astro";
import Layout from "../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";
import olympians from "../assets/olympians.json";
import pizzas from "../assets/pizza.json";


const penguinsAdelie = penguins.filter(({ species }) => species === "Adelie");
const penguinsGentoo = penguins.filter(({ species }) => species === "Gentoo");
const penguinsChinstrap = penguins.filter(({ species }) => species === "Chinstrap");
---

<Layout>
 <nav class="flex flex-wrap gap-2">
    <button class="bg-green-500 m-1 rounded border px-3 py-2"><a href="/">Schéma Penguins</a></button>
    <button class="bg-green-500 m-1 rounded border px-3 py-2"><a href="/graphique2">Schéma Olympians</a></button>
    <button class="bg-green-500 m-1 rounded border px-3 py-2"><a href="/graphique3">Schéma Pizzas</a></button>
  <select class="m-1 rounded border px-3 py-2 bg-green-500" id="species">
      <option class="" value="Adelie">Adelie</option>
      <option class="" value="Chinstrap">Chinstrap</option>
      <option class="" value="Gentoo">Gentoo</option>
  </select>
  <script>
      document.querySelector("#species")?.addEventListener("change", (evt) => {
      const value = (evt.target as HTMLSelectElement).value;
      location.pathname = "/species/" + value;
      });
  </script>
  </nav>


  <h1 class="text-2xl m-2">Tous les schémas</h1>
<div class="carousel w-full rounded-box">


  <div id="item1" class="carousel-item w-full flex-col">
    <h2 id="penguins" class="text-2xl m-2">Schéma Penguins</h2>
    <PlotFigure
      options={{
        marks: [
          Plot.dot(penguins, {
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            stroke: "species",
          }),
        ],
      }}
    />
    <div class="flex justify-between mt-4">
<a href="#item5" class="btn m-10 bg-lime-500 text-white">❮</a>
      <a href="#item1" class="btn m-10 bg-lime-500 text-white">❯</a>
    </div>
  </div>

  <div id="item2" class="carousel-item w-full flex-col">
    <h2 id="olympians" class="text-2xl m-2">Schéma Olympians</h2>
    <PlotFigure
      options={{
        marks: [
          Plot.dot(olympians, {
            x: "height",
            y: "weight",
          }),
        ],
      }}
    />
    <div class="flex justify-between mt-4">
<a href="#item5" class="btn m-10 bg-lime-500 text-white">❮</a>
      <a href="#item1" class="btn m-10 bg-lime-500 text-white">❯</a>
    </div>
  </div>


  <div id="item3" class="carousel-item w-full flex-col">
    <h2 id="pizzas" class="text-2xl m-2">Schéma Pizzas</h2>
    <PlotFigure
      options={{
        marks: [
          Plot.dot(pizzas, {
            x: "diameter",
            y: "price",
          }),
        ],
      }}
    />
    <div class="flex justify-between mt-4">
<a href="#item5" class="btn m-10 bg-lime-500 text-white">❮</a>
      <a href="#item1" class="btn m-10 bg-lime-500 text-white">❯</a>
    </div>
  </div>

  <div id="item4" class="carousel-item w-full flex-col">
    <h2 id="adelie" class="text-2xl m-2">Schéma Adelie</h2>
    <PlotFigure
      options={{
        marks: [
          Plot.dot(penguinsAdelie, {
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            stroke: "species",
          }),
        ],
      }}
    />
    <div class="flex justify-between mt-4">
<a href="#item5" class="btn m-10 bg-lime-500 text-white">❮</a>
      <a href="#item1" class="btn m-10 bg-lime-500 text-white">❯</a>
    </div>
  </div>


  <div id="item5" class="carousel-item w-full flex-col">
    <h2 id="gentoo" class="text-2xl m-2">Schéma Gentoo</h2>
    <PlotFigure
      options={{
        marks: [
          Plot.dot(penguinsGentoo, {
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            stroke: "species",
          }),
        ],
      }}
    />
    <div class="flex justify-between mt-4">
<a href="#item5" class="btn m-10 bg-lime-500 text-white">❮</a>
      <a href="#item1" class="btn m-10 bg-lime-500 text-white">❯</a>
    </div>
  </div>

 
  <div id="item6" class="carousel-item w-full flex-col">
    <h2 id="chinstrap" class="text-2xl m-2">Schéma Chinstrap</h2>
    <PlotFigure
      options={{
        marks: [
          Plot.dot(penguinsChinstrap, {
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            stroke: "species",
          }),
        ],
      }}
    />
    <div class="flex justify-between mt-4">
      <a href="#item5" class="btn m-10 bg-lime-500 text-white">❮</a>
      <a href="#item1" class="btn m-10 bg-lime-500 text-white">❯</a>
    </div>
  </div>

</div>
</Layout>