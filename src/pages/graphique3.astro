---
import Layout from '../layouts/Layout.astro';
import PlotFigure from '../components/PlotFigure.astro';
import * as Plot from "@observablehq/plot";
import pizzas from "../assets/pizza.json";
---
<Layout>
  <nav class="flex flex-wrap gap-2">
    <button class="m-1 rounded border px-3 py-2"><a href="/">Schéma Penguins</a></button>
    <button class="m-1 rounded border px-3 py-2"><a href="/graphique2">Schéma Olympians</a></button>
    <button class="m-1 rounded border px-3 py-2"><a href="/graphique3">Schéma Pizzas</a></button>
    <button class="m-1 rounded border px-3 py-2"><a href="/species/Adelie">Schéma Adelie</a></button>
    <button class="m-1 rounded border px-3 py-2"><a href="/species/Gentoo">Schéma Gentoo</a></button>
    <button class="m-1 rounded border px-3 py-2"><a href="/species/Chinstrap">Schéma Chinstrap</a></button>
    <button class="m-1 rounded border px-3 py-2"><a href="/graphiqueall">Tous les schémas</a></button>
  </nav>
  <h1 class="text-2xl">Schéma Pizzas</h1>
<PlotFigure
          options={{
marks: [
              Plot.dot(pizzas, {
                x: "diameter",
                y: "price",
              })
            ]
          }}
        />
        <button class="m-1 rounded border px-3 py-2"><a href="/species/Adelie">Suivant</a></button>
</Layout>